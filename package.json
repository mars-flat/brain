{
  "name": "brain",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "brain": "bun packages/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "depcruise": "bunx --bun depcruise packages adapters --config .dependency-cruiser.cjs",
    "check": "bun run lint && bun run typecheck && bun run depcruise && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@brain/brainstore": "workspace:*",
    "@brain/cli": "workspace:*",
    "@brain/consolidator": "workspace:*",
    "@brain/contracts": "workspace:*",
    "@brain/core": "workspace:*",
    "@brain/queue-sqlite": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "typescript": "6.0.3"
  }
}
