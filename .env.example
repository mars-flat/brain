# Copy to .env and fill in. Only this example file is ever committed (§9.2).

# Path to your PRIVATE vault — its own git repo, never tracked by the code repo
# (§9.1). Required with no default: a missing value fails loudly rather than
# silently writing memory somewhere git-tracked.
BRAIN_VAULT_PATH=./vault

# OpenAI — used by the consolidator from P2 on (§5.8)
OPENAI_API_KEY=sk-REPLACE_ME
